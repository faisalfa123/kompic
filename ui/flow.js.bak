(function(){
var POS={start:{x:95,y:180,w:130,h:70},berhenti:{x:285,y:180,w:150,h:104},panas:{x:475,y:180,w:150,h:104},waktu:{x:665,y:180,w:150,h:104},ambil:{x:855,y:180,w:150,h:84},padatkan:{x:1045,y:180,w:160,h:90},timbang:{x:1245,y:180,w:150,h:104},ganti:{x:1450,y:80,w:150,h:70},simpan:{x:1450,y:280,w:150,h:70},mega:{x:1620,y:180,w:150,h:84}};
var MARK='<defs><marker id="ah" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto"><path d="M0,0 L10,4 L0,8 z" fill="#475569"/></marker><marker id="ahb" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto"><path d="M0,0 L10,4 L0,8 z" fill="#3b82f6"/></marker><marker id="ahr" markerWidth="10" markerHeight="8" refX="9" refY="4" orient="auto"><path d="M0,0 L10,4 L0,8 z" fill="#ef4444"/></marker></defs>';
function esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
function base(p){var a=(p||'').split('/');return a[a.length-1]||'';}
function sty(st){var C={on:'#3b82f6',proc:'#3b82f6',warn:'#eab308',stop:'#ef4444',hot:'#ef4444',rep:'#22c55e',skp:'#eab308'};if(st==='dim')return 'opacity:.3;stroke:#334155;';var c=C[st]||'#334155',s='stroke:'+c+';';if(st==='proc'||st==='hot')s+='animation:pulse 1s infinite;';if(st==='on'||st==='proc')s+='filter:drop-shadow(0 0 6px #3b82f6);';else if(st==='warn'||st==='skp')s+='filter:drop-shadow(0 0 6px #eab308);';else if(st==='stop'||st==='hot')s+='filter:drop-shadow(0 0 6px #ef4444);';else if(st==='rep')s+='filter:drop-shadow(0 0 6px #22c55e);';return s;}
function txts(cx,cy,ln){var n=ln.length,g='',sy=cy-(n-1)*9;for(var i=0;i<n;i++){var fs=i===0?12:10,fl=i===0?'#f1f5f9':'#94a3b8',fw=i===0?700:400;g+='<text x="'+cx+'" y="'+(sy+i*18)+'" style="fill:'+fl+';font-size:'+fs+'px;font-weight:'+fw+';text-anchor:middle;dominant-baseline:middle">'+esc(ln[i])+'</text>';}return g;}
function ndRect(k,ln,st,bar){var p=POS[k],x=p.x-p.w/2,y=p.y-p.h/2,g='<g style="'+sty(st)+'"><rect x="'+x+'" y="'+y+'" width="'+p.w+'" height="'+p.h+'" rx="10" style="fill:#0f172a"/>';g+=txts(p.x,p.y,ln);if(bar!=null){var bw=p.w-24,by=y+p.h-13;g+='<rect x="'+(p.x-bw/2)+'" y="'+by+'" width="'+bw+'" height="6" rx="3" style="fill:#334155"/><rect x="'+(p.x-bw/2)+'" y="'+by+'" width="'+(bw*Math.max(0,Math.min(100,bar))/100)+'" height="6" rx="3" style="fill:#3b82f6"/>';}return g+'</g>';}
function ndDia(k,ln,st){var p=POS[k],hw=p.w/2,hh=p.h/2,cx=p.x,cy=p.y;return '<g style="'+sty(st)+'"><polygon points="'+cx+','+(cy-hh)+' '+(cx+hw)+','+cy+' '+cx+','+(cy+hh)+' '+(cx-hw)+','+cy+'" style="fill:#0f172a"/>'+txts(cx,cy,ln)+'</g>';}
function arrow(a,b,flow){var A=POS[a],B=POS[b],x1=A.x+A.w/2,y1=A.y,x2=B.x-B.w/2,y2=B.y;var mk=flow?'#ahb':'#ah',s=flow?'stroke:#3b82f6;stroke-dasharray:6 6;animation:dash 1s linear infinite;':'stroke:#475569;';return '<path d="M'+x1+','+y1+' L'+x2+','+y2+'" style="fill:none;'+s+'marker-end:url('+mk+')"/>';}
function elb(a,b,flow){var A=POS[a],B=POS[b],x1=A.x+A.w/2,y1=A.y,x2=B.x-B.w/2,y2=B.y,mx=(x1+x2)/2;var mk=flow?'#ahb':'#ah',s=flow?'stroke:#3b82f6;stroke-dasharray:6 6;animation:dash 1s linear infinite;':'stroke:#475569;';return '<path d="M'+x1+','+y1+' H'+mx+' V'+y2+' H'+x2+'" style="fill:none;'+s+'marker-end:url('+mk+')"/>';}
function bypassArc(on){var P=POS.panas,T=POS.ambil,x1=P.x,y1=P.y-P.h/2,x2=T.x,y2=T.y-T.h/2,topY=34;var s=on?'stroke:#ef4444;stroke-dasharray:5 5;animation:dash 1s linear infinite;':'stroke:#475569;stroke-dasharray:5 5;';var mk=on?'#ahr':'#ah';return '<path d="M'+x1+','+y1+' V'+topY+' H'+x2+' V'+y2+'" style="fill:none;'+s+'marker-end:url('+mk+')"/><text x="'+((x1+x2)/2)+'" y="'+(topY-6)+'" style="fill:'+(on?'#ef4444':'#64748b')+';font-size:11px;font-weight:700;text-anchor:middle">FORCE: lewati jadwal</text>';}
function loopCurve(on){var M=POS.mega,S=POS.start,x1=M.x,y1=M.y+M.h/2,x2=S.x,y2=S.y+S.h/2,by=420;var mk=on?'#ahb':'#ah',s=on?'stroke:#3b82f6;stroke-dasharray:6 6;animation:dash 1s linear infinite;':'stroke:#475569;';return '<path d="M'+x1+','+y1+' C'+x1+','+by+' '+x2+','+by+' '+x2+','+y2+'" style="fill:none;'+s+'marker-end:url('+mk+')"/><text x="'+((x1+x2)/2)+'" y="'+(by+18)+'" style="fill:'+(on?'#3b82f6':'#64748b')+';font-size:11px;font-weight:700;text-anchor:middle">Ulangi dari awal</text>';}
function states(d){var sys=d.system||{},st=d.stats||{},ap=d.active_processes||{},rf=d.recent_files||[];var comp=ap.compression||{},bak=ap.backup||{},last=rf[0]||{};var compOn=!!comp.file,bakOn=!!bak.file,pause=!!sys.manual_pause,heat=sys.global_state==='OVERHEAT',force=!!sys.force_mode;var pos=sys.position_status||'',inSched=pos.indexOf('RUNNING')===0;var gate=!pause&&!heat&&(force||inSched);var S={};S.start={st:'on',ln:['Mulai','loop cek kondisi']};S.berhenti={st:pause?'stop':'warn',ln:['Disuruh berhenti?',pause?'YA -> bekukan':'TIDAK -> lanjut']};S.panas={st:pause?'dim':(heat?'hot':'warn'),ln:['Kepanasan?',heat?'YA -> jeda, backup':(pause?'-':'TIDAK -> '+sys.temp_c+'C')]};S.waktu={st:pause?'dim':(force?'on':(inSched?'warn':'stop')),ln:['Sudah waktunya?',force?'FORCE -> lewati':(inSched?'YA -> jalan':'MENUNGGU jadwal')]};S.ambil={st:gate?'on':'dim',ln:['Ambil antrean','Antre '+(st.pending||0)+' Proses '+(st.processing_count||0)]};S.padatkan={st:gate?(compOn?'proc':'dim'):'dim',ln:['Padatkan media',compOn?(base(comp.file)+' '+comp.stage):(gate?'idle':'-')],bar:compOn?(comp.percent||0):null};S.timbang={st:gate?(compOn?'proc':'dim'):'dim',ln:['Hasil lebih kecil?','bandingkan ukuran']};S.ganti={st:(gate&&compOn&&last.status==='DONE_COMPRESSED')?'rep':'dim',ln:['Ganti (hemat)',last.percent_saved!=null?('terakhir '+last.percent_saved+'%'):'-']};S.simpan={st:(gate&&compOn&&last.status==='SKIPPED_BOROS')?'skp':'dim',ln:['Simpan asli','hasil lebih besar']};var megaGate=!pause&&(bakOn||force||!compOn);S.mega={st:!pause?(bakOn?'proc':(megaGate?(force?'warn':'on'):'dim')):'dim',ln:['Kirim MEGA',bakOn?(base(bak.file)+' '+(bak.percent||0)+'%'):('mode '+(force?'FORCE':'NORMAL'))],bar:bakOn?(bak.percent||0):null};S._gate=gate;S._bypass=(force&&!pause);S._loop=!pause;return S;}
function buildEdges(S){var e='';e+=arrow('start','berhenti',S._loop);e+=arrow('berhenti','panas',S._loop);e+=arrow('panas','waktu',S._loop);e+=arrow('waktu','ambil',S._gate);e+=arrow('ambil','padatkan',S._gate);e+=arrow('padatkan','timbang',S._gate);e+=elb('timbang','ganti',S._gate);e+=elb('timbang','simpan',S._gate);e+=elb('ganti','mega',S._gate);e+=elb('simpan','mega',S._gate);e+=bypassArc(S._bypass);e+=loopCurve(S._loop);return e;}
function buildNodes(S){var n='';n+=ndRect('start',S.start.ln,S.start.st);n+=ndDia('berhenti',S.berhenti.ln,S.berhenti.st);n+=ndDia('panas',S.panas.ln,S.panas.st);n+=ndDia('waktu',S.waktu.ln,S.waktu.st);n+=ndRect('ambil',S.ambil.ln,S.ambil.st);n+=ndRect('padatkan',S.padatkan.ln,S.padatkan.st,S.padatkan.bar);n+=ndDia('timbang',S.timbang.ln,S.timbang.st);n+=ndRect('ganti',S.ganti.ln,S.ganti.st);n+=ndRect('simpan',S.simpan.ln,S.simpan.st);n+=ndRect('mega',S.mega.ln,S.mega.st,S.mega.bar);return n;}
function renderFlow(d){var S=states(d);var svg='<svg viewBox="0 0 1700 460" preserveAspectRatio="xMidYMid meet" style="width:100%;min-width:1700px;height:auto;display:block">'+MARK+buildEdges(S)+buildNodes(S)+'</svg>';var el=document.getElementById('stepper');if(el)el.innerHTML=svg;}
function tickFlow(){fetch('?api=dashboard_data').then(function(r){return r.json();}).then(function(d){if(d&&d.ok)renderFlow(d);}).catch(function(e){console.error('flow',e);});}
function bootFlow(){tickFlow();setInterval(tickFlow,2500);}
if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',bootFlow);}else{bootFlow();}
})();
